# Copy this file to backend/.env. The server reads that file on startup.
#
# One xAI key covers Grok Voice and Grok policy parsing.
# Leave GEMINI_API_KEY blank to parse spoken orders with Grok instead.
XAI_API_KEY=

# auto = Gemini if GEMINI_API_KEY is set, otherwise Grok, otherwise keywords.
# Set to grok to force Grok even when a Gemini key is also present.
POLICY_PARSER=auto
GROK_MODEL=grok-4

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback chains (backend/llm.py). Grok and ASI:One fall back to Claude, then to the
# keyword parser or template, so a provider that is down or rate-limited never stops
# the demo. Voice transcription stays on Grok only.
#   /command            Gemini or Grok -> Claude -> keywords
#   /debrief /plans     Grok -> Claude
#   /verdict            Grok -> Claude -> numbers from the simulator
#   Fetch.ai coordinator  ASI:One -> Grok -> Claude -> keywords / template
ANTHROPIC_API_KEY=
# LLM_CLAUDE_MODEL=claude-sonnet-5-5
# LLM_CLAUDE_EFFORT=low
ASI_ONE_API_KEY=
# ASI_MODEL=asi1-mini
# Skip a provider that is misbehaving on stage, for example LLM_DISABLE=grok
# LLM_DISABLE=

# Optional. The demo uses backend/data/fall-2026-class-load.json without these.
# UM_CLIENT_ID=
# UM_CLIENT_SECRET=
# UM_TERM=
# SOC_CSV=
